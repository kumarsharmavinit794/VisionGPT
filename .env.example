APP_NAME=Vision AI
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/visionai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

SECRET_KEY=replace-this-with-64-char-random-string-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava
OLLAMA_TIMEOUT=60
VLM_MAX_IMAGE_SIZE=1024
VLM_IMAGE_QUALITY=85

UPLOAD_DIR=app/uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=["png","jpg","jpeg","webp"]

RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

LOG_LEVEL=INFO
LOG_DIR=logs
